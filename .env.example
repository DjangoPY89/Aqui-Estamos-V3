# ===================================================
# Aquí Estamos - Variables de Entorno y Autenticación
# ===================================================

# NextAuth Configuración General
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=aquiestamos-super-secret-key-production-2026-xyz

# Google OAuth (Obtener en Google Cloud Console > APIs & Services > Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In OAuth (Obtener en Apple Developer Portal)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/apple
APPLE_ID=
APPLE_SECRET=

# Base de Datos SQLite (Ubicación del archivo local)
DATABASE_PATH=./data/aquiestamos.db

# Configuración de Notificaciones / Contacto
NEXT_PUBLIC_WHATSAPP_PHONE=595984320528
NEXT_PUBLIC_CORPORATE_PHONE=595983463553
NEXT_PUBLIC_APP_NAME="Aquí Estamos"
